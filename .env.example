# Copy to .env. The defaults run fully offline with no API keys.

# Interpreter: rule_based (offline), groq (free tier) or openai_compat (any OpenAI-style API)
INTERPRETER=rule_based

# One free Groq key covers both the LLM and Whisper speech-to-text: https://console.groq.com
GROQ_API_KEY=

# For INTERPRETER=openai_compat (OpenRouter, Cerebras, GitHub Models, ...)
LLM_BASE_URL=
LLM_API_KEY=

# Leave empty to use the provider default (Groq: openai/gpt-oss-120b)
LLM_MODEL=
LLM_TIMEOUT_S=8
# Groq reasoning models: low/medium/high for gpt-oss, none for Qwen. Empty = sensible default.
LLM_REASONING_EFFORT=
# Only used for the cost estimate shown per call. Empty = provider default (0 for Groq free tier).
LLM_PRICE_IN_PER_MTOK=
LLM_PRICE_OUT_PER_MTOK=

# Server-side speech-to-text: mock (file-name lookup, offline), groq or openai
STT_PROVIDER=mock
# Empty = provider default (Groq: whisper-large-v3-turbo, OpenAI: whisper-1)
STT_MODEL=
OPENAI_API_KEY=

# Limits and session
MAX_AUDIO_MB=10
MAX_TEXT_CHARS=2000
SESSION_TTL_S=1800

# Mock auth: clinician used when no X-Clinician-Id header is sent. Leave empty to require the header.
DEFAULT_CLINICIAN_ID=dr_demo
